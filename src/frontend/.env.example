# Frontend (Next.js) — variáveis NEXT_PUBLIC_* são embutidas em BUILD TIME.
# Na Vercel: defina-as e faça um REDEPLOY (rebuild) para valerem.

# URL do backend (Express). Produção = domínio do projeto de backend na Vercel.
# Ex local: http://localhost:3001
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app

# Supabase (auth Microsoft/Azure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Bypass do login OAuth. 'true' pula a autenticação Microsoft (APENAS dev).
# Em produção deixe 'false' (ou não defina) para exigir login.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
