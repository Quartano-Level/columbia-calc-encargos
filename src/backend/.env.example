# Supabase Configuration
# Get these values from your Supabase project settings (https://app.supabase.com)

# Project URL - found in Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous (public) key - found in Project Settings > API > Project API keys
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - found in Project Settings > API > Project API keys
# WARNING: Keep this secret! It bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Conexos ERP — Autenticação (OBRIGATÓRIO)
# Sem estes valores o backend não consegue autenticar no Conexos e toda rota
# que depende do ERP (/processes, /filiais, etc.) retorna erro.
CONEXOS_BASE_URL=https://columbiatrading.conexos.cloud/api
CONEXOS_USERNAME=your-conexos-user
CONEXOS_PASSWORD=your-conexos-password

# Port for the backend server
PORT=3001

# Logs verbosos (boxLog, etapas de fluxo, etc). Use 1 para debug.
# DEBUG_VERBOSE=1

# Conexos — Configurações operacionais (valores padrão = Columbia Trading filial 2)
# CONEXOS_FIL_COD=2       # Código da filial (cnx-filcod)
# CONEXOS_IMP_COD=1081    # Código do importador
# CONEXOS_CTP_COD=672     # Código do centro de custo (Encargos Financeiros)
# CONEXOS_USN_COD=97      # Código do usuário (cnx-usncod)

# Cálculo — Base de dias para conversão de taxa anual → diária
# 360 = dias corridos (padrão, câmbio BR); 252 = dias úteis (padrão BCB/CDI)
# CALC_BASE_DIAS=360